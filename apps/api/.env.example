NODE_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://causeway:causeway@127.0.0.1:5432/causeway?schema=public
JWT_SECRET=dev-local-jwt-secret-change-before-production
JWT_EXPIRES_IN=7d
SUPPORTED_CHAIN_IDS=137

POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
POLYMARKET_DATA_API_ENABLED=true
POLYMARKET_HTTP_TIMEOUT_MS=10000
POLYMARKET_HTTP_RETRIES=2
POLYMARKET_MARKET_SYNC_ENABLED=false
POLYMARKET_MARKET_SYNC_INTERVAL_MS=300000
POLYMARKET_MARKET_SYNC_LIMIT=1000
POLYMARKET_MARKET_SYNC_LOCK_TTL_MS=900000
POLYMARKET_MARKET_SYNC_RUN_ON_STARTUP=false

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_HTTP_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4000

ENABLE_REAL_ORDERS=false
DRY_RUN=true
INTERNAL_API_TOKEN=dev-local-internal-token-change-before-production

LOG_LEVEL=log
LOG_HTTP_REQUESTS=true

RATE_LIMIT_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_INTERNAL_MAX=300
