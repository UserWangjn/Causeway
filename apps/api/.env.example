NODE_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OUTBOUND_PROXY_URL=

DATABASE_URL=postgresql://causeway:causeway@127.0.0.1:5432/causeway?schema=public
JWT_SECRET=dev-local-jwt-secret-change-before-production
JWT_EXPIRES_IN=7d
SUPPORTED_CHAIN_IDS=137
AUTH_SIWE_URI=http://localhost:5173
AUTH_SIWE_STATEMENT=Sign in to Causeway.
AUTH_POLYGON_RPC_URL=

POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_RELAYER_BASE_URL=https://relayer-v2.polymarket.com
POLYMARKET_BRIDGE_BASE_URL=https://bridge.polymarket.com
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
POLYMARKET_CLOB_API_ADDRESS=
POLYMARKET_CLOB_SIGNATURE_TYPE=2
POLYMARKET_CLOB_FUNDER_ADDRESS=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
POLYMARKET_BUILDER_CODE=
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
POLYMARKET_DATA_API_ENABLED=true
POLYMARKET_HTTP_TIMEOUT_MS=10000
POLYMARKET_HTTP_RETRIES=2
POLYMARKET_MARKET_SYNC_ENABLED=false
POLYMARKET_MARKET_SYNC_MODE=incremental
POLYMARKET_MARKET_SYNC_INTERVAL_MS=900000
POLYMARKET_MARKET_SYNC_LIMIT=1000
POLYMARKET_MARKET_SYNC_LOCK_TTL_MS=900000
POLYMARKET_MARKET_SYNC_RUN_ON_STARTUP=false
POLYMARKET_HOT_MARKET_SYNC_ENABLED=true
POLYMARKET_HOT_MARKET_SYNC_INTERVAL_MS=300000
POLYMARKET_HOT_MARKET_SYNC_LIMIT=250
POLYMARKET_HOT_MARKET_SYNC_EVENT_LIMIT=50

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOWED_MODELS=
AI_THINKING_MODE=
AI_HTTP_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=8000

ENABLE_REAL_ORDERS=false
# Test-only dry-run order mode. Keep false for normal development and production-like runs.
DRY_RUN=false
CREDENTIAL_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=dev-local-internal-token-change-before-production

ARC_USDC_PAYMENTS_ENABLED=false
# Optional helper: run `npm run arc:rpc` after installing ARC CLI to retrieve a Canteen Arc RPC URL.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_PAYMENT_RECEIVER_ADDRESS=
ARC_PAYMENT_INTENT_TTL_MS=900000
ARC_PAYMENT_MIN_CONFIRMATIONS=1
ARC_PREMIUM_MONTHLY_MICRO_USDC=1000000
ARC_PREMIUM_MONTHLY_DAYS=30
ARC_PREMIUM_YEARLY_MICRO_USDC=10000000
ARC_PREMIUM_YEARLY_DAYS=365

LOG_LEVEL=log
LOG_HTTP_REQUESTS=true

RATE_LIMIT_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_INTERNAL_MAX=300

MAINTENANCE_CLEANUP_ENABLED=true
MAINTENANCE_CLEANUP_INTERVAL_MS=3600000
WALLET_SESSION_RETENTION_DAYS=30
POLYMARKET_AUTH_CHALLENGE_RETENTION_DAYS=7
ORDER_PREVIEW_RETENTION_DAYS=7
AUDIT_EVENT_RETENTION_DAYS=90
